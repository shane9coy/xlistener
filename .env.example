# XListener credentials — copy to .env and fill in. NEVER commit .env.
#
# Two independent apps are involved:
#   1. an X developer app   (webhooks + the account being mirrored)
#   2. a Meta/Threads app   (the account you publish to)
#
# ── X (developer app) ─────────────────────────────────────────────────────────
# OAuth 1.0a user-context keys. Used to read the timeline in tools/replay_backlog.py.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# App-only Bearer Token. REQUIRED: /2/webhooks and /2/activity/subscriptions accept
# only this token. It is NOT used to sign CRC responses or webhook signatures.
X_BEARER_TOKEN=

# OAuth 2.0 Client Secret (Developer Console → your app → Keys and tokens).
# Recommended by X's current webhook docs: CRC response tokens and the
# X-Twitter-Webhooks-Signature-OAuth2 header are keyed with this, not with the
# OAuth 1.0 consumer secret. Leave empty only for OAuth1-only apps.
X_OAUTH2_CLIENT_SECRET=

# ── Threads (Meta app) ────────────────────────────────────────────────────────
# Threads App ID / Secret. Use the *Threads* App ID from the "Access the Threads
# API" use case — the Facebook App ID is a different number and is rejected by
# graph.threads.net. Only needed for the initial OAuth flow and token refresh;
# tools/threads_oauth.py writes them for you.
THREADS_APP_ID=
THREADS_APP_SECRET=

# 60-day long-lived Threads user token (Graph API). See tools/threads_oauth.py.
THREADS_ACCESS_TOKEN=
# Numeric Threads user id (NOT your @handle, and NOT the Facebook user id).
THREADS_USER_ID=

# Optional: point the poster at a different env file.
# THREADS_POST_ENV=/abs/path/to/.env
